{
  "framework": "other",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/newsletter/generate",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/newsletter/send",
      "schedule": "0 13 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/api/market-intel/:section", "destination": "/api/market-intel?section=:section" },
    { "source": "/members", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
